# Copy this to .env.local and fill in real values. .env.local is git-ignored;
# this file is committed and must never contain a real secret.

# Required — the Contact form (/api/leads) and Apply form (/api/apply) can't
# save anything without these. Project Settings -> API in Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same project, same anon key, NEXT_PUBLIC_-prefixed so the browser bundle can
# see them — the admin dashboard's login/session/leads code runs client-side
# (lib/supabase/client.ts). Safe to expose publicly by design; RLS protects
# the data, not the key being secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — email notification alongside the Supabase write no-ops (logs a
# warning) until this is set. See lib/resend.ts.
RESEND_API_KEY=

# Required for two admin-only features, both no-op gracefully without it:
# 1. A short-lived signed URL for a just-uploaded resume
#    (app/api/apply/route.ts) so staff can open it from the email
#    notification — without it, resumes still upload fine, the notification
#    just can't link to one.
# 2. Inviting a new staff member (app/api/admin/staff/route.ts) — without
#    it, the "Invite Staff Member" button fails with a clear error instead
#    of creating an account.
# Project Settings -> API -> service_role (secret) in Supabase. Never
# expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — bot protection on the Apply form (CLAUDE.md Section 7). Without
# these, verifyTurnstile() no-ops and the widget doesn't render, so the form
# still works, just without bot protection. Cloudflare dashboard -> Turnstile.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
