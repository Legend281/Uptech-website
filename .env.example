# Environment variable NAMES for this project — values are always empty here.
# Local development: copy to .env.local (git-ignored) and fill in.
# Production: set each one in Hostinger hPanel -> the Node.js app -> Environment
# variables. Hostinger applies them to both the build and the running server.
# This file is committed and must never contain a real value.
#
# Two kinds of variable:
#   [PUBLIC]  NEXT_PUBLIC_* — copied into the browser JavaScript AT BUILD TIME.
#             Visible to every visitor, so never put a secret in one. Changing
#             one requires a rebuild/redeploy, not just a restart.
#   [SERVER]  Read only by server code (API routes, server components,
#             middleware, next.config). Never reaches the browser.
# Status: Required = the site breaks or a core feature fails without it.
#         Optional = the feature quietly switches off without it.

# --- Supabase -------------------------------------------------------------------

# [SERVER] Required. Project URL (Supabase -> Project Settings -> API). Also
# read by next.config.mjs at BUILD time to allow the Supabase origin in the
# Content-Security-Policy — if it's missing during the build, the live site's
# browser requests to Supabase get blocked.
SUPABASE_URL=
# [SERVER] Required. Anon key, used by server-side public reads (blog, FAQs,
# team, testimonials) and the Contact/Apply forms. Public by design; RLS
# protects the data.
SUPABASE_ANON_KEY=

# [PUBLIC] Required. Same URL and anon key as above, for the admin dashboard's
# browser-side login/session code (lib/supabase/client.ts) and middleware.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [SERVER] Required for staff invites, resume links in notification emails,
# the Client Onboarding webhook and the daily digest. Bypasses all row-level
# security — the most sensitive value in this file. Never give it a
# NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site identity ---------------------------------------------------------------

# [PUBLIC] Required in production. The live origin, e.g. https://example.com
# (sitemap, robots.txt, canonical URLs, social previews — lib/siteUrl.ts).
NEXT_PUBLIC_SITE_URL=

# [SERVER] Optional. Bare hostname (no https://) that serves the admin
# dashboard on its own subdomain (middleware.ts). Leave unset until that
# subdomain's DNS + Hostinger setup exists; unset = /admin on the main domain.
ADMIN_HOSTNAME=

# --- Email (Resend) --------------------------------------------------------------

# [SERVER] Optional. Lead/application notification emails; without it they're
# skipped (the lead is still saved).
RESEND_API_KEY=
# [SERVER] Optional. Per-department inboxes for those notifications; each
# falls back to NOTIFY_EMAIL_DEFAULT, then to the built-in shared address.
NOTIFY_EMAIL_CAREER_SERVICES=
NOTIFY_EMAIL_BUSINESS_FORMALISATION=
NOTIFY_EMAIL_DEFAULT=

# --- Shared secrets for incoming automated requests ---------------------------

# [SERVER] Required for Client Onboarding. Long random string the Google Apps
# Script sends in the x-webhook-secret header to /api/onboarding-webhook.
ONBOARDING_WEBHOOK_SECRET=
# [SERVER] Required for the daily digest. Long random string the scheduler
# sends in the x-digest-secret header to /api/admin/daily-digest.
DAILY_DIGEST_SECRET=

# --- Bot protection (Cloudflare Turnstile) -------------------------------------

# [PUBLIC] Optional. Site key that renders the widget on public forms.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# [SERVER] Optional. Secret key that verifies the widget's token server-side.
TURNSTILE_SECRET_KEY=

# --- Error monitoring (Sentry) ---------------------------------------------------

# [PUBLIC] Optional. Not a secret by Sentry's design.
NEXT_PUBLIC_SENTRY_DSN=
# [SERVER] Optional, build-time only. Uploads source maps so production stack
# traces are readable. SENTRY_AUTH_TOKEN is a real secret.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Google Reviews (dormant pending a leadership decision) -------------------

# [SERVER] Optional. Places API (New) key + the business's Place ID.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# --- Never set these on Hostinger ----------------------------------------------
# STATIC_EXPORT, NEXT_PUBLIC_BASE_PATH — used only by the GitHub Pages preview
#   workflow; setting them on Hostinger turns the site into a broken static export.
# NEXT_DIST_DIR — local tool for test builds alongside a running dev server.
# NODE_ENV, NEXT_RUNTIME — set automatically by Next.js.
