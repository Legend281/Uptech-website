# Copy this to .env.local and fill in real values. .env.local is git-ignored;
# this file is committed and must never contain a real secret.

# Required — the Contact form (/api/leads) and Apply form (/api/apply) can't
# save anything without these. Project Settings -> API in Supabase.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same project, same anon key, NEXT_PUBLIC_-prefixed so the browser bundle can
# see them — the admin dashboard's login/session/leads code runs client-side
# (lib/supabase/client.ts). Safe to expose publicly by design; RLS protects
# the data, not the key being secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — email notification alongside the Supabase write no-ops (logs a
# warning) until this is set. See lib/resend.ts.
RESEND_API_KEY=

# Required for two admin-only features, both no-op gracefully without it:
# 1. A short-lived signed URL for a just-uploaded resume
#    (app/api/apply/route.ts) so staff can open it from the email
#    notification — without it, resumes still upload fine, the notification
#    just can't link to one.
# 2. Inviting a new staff member (app/api/admin/staff/route.ts) — without
#    it, the "Invite Staff Member" button fails with a clear error instead
#    of creating an account.
# Project Settings -> API -> service_role (secret) in Supabase. Never
# expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional — bot protection on the Apply form (CLAUDE.md Section 7). Without
# these, verifyTurnstile() no-ops and the widget doesn't render, so the form
# still works, just without bot protection. Cloudflare dashboard -> Turnstile.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional, but set this before the real deployment — the real public domain
# once management confirms it (see lib/siteUrl.ts). Without it, sitemap.xml,
# robots.txt, and social-share preview links (Open Graph/Twitter) fall back
# to a placeholder domain and log a console warning. e.g. https://example.com
NEXT_PUBLIC_SITE_URL=

# Optional — production error monitoring (instrumentation-client.ts,
# instrumentation.ts). Without it, Sentry.init() runs with no dsn and sends
# nothing; no error, no warning, the site works identically either way.
# Free at sentry.io: create a project (platform: Next.js), the DSN is shown
# immediately, no card required on the free tier. DSNs aren't secret — safe
# to expose client-side by Sentry's own design, same as the Supabase anon
# key above.
NEXT_PUBLIC_SENTRY_DSN=

# Optional, and only useful together — lets Sentry upload real source maps
# at build time, so a production error's stack trace is readable in
# Sentry's dashboard instead of pointing at minified code. Without these,
# error reporting still works fully; only the stack traces are minified.
# Sentry dashboard -> Settings -> Auth Tokens (needs project:releases scope).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Required — the shared secret the Google Apps Script (Client Onboarding
# form) must send in the x-webhook-secret header. Without it,
# /api/onboarding-webhook refuses every submission. Any long random string.
ONBOARDING_WEBHOOK_SECRET=

# Required for the daily digest to run — the shared secret an external
# scheduler (Hostinger's cron, or a free service like cron-job.org) must
# send in the x-digest-secret header when it POSTs to
# /api/admin/daily-digest once a day. Without it, that route refuses every
# request. Any long random string, same idea as ONBOARDING_WEBHOOK_SECRET.
DAILY_DIGEST_SECRET=

# Optional — routes new-lead/application notification emails (lib/resend.ts)
# to a department-specific inbox instead of the one shared address. Either
# or both can be left unset; whichever isn't set falls back to
# NOTIFY_EMAIL_DEFAULT, or the hardcoded shared address if that's unset too.
NOTIFY_EMAIL_CAREER_SERVICES=
NOTIFY_EMAIL_BUSINESS_FORMALISATION=
NOTIFY_EMAIL_DEFAULT=
